

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  firstName        String
  lastName         String
  currentRole      String?        // filled during onboarding
  targetRole       String?        // filled during onboarding
  weeklyHours      Int?           // 2–20, filled during onboarding
  targetMonths     Int?           // 3, 6, or 12, filled during onboarding
  onboardingDone   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  roadmaps         Roadmap[]
  weeklyReviews    WeeklyReview[]
  topicProgress    UserTopicProgress[]
  quizAttempts     QuizAttempt[]
  refreshTokens    RefreshToken[]
  bookmarks        UserResourceBookmark[]
  explainSessions  ExplainSession[]       // [v1.2]
}

// ─────────────────────────────────────────
// REFRESH TOKEN
// Stored server-side to support token rotation and revocation.
// ─────────────────────────────────────────

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
}

// ─────────────────────────────────────────
// ROADMAP
// One active roadmap per user (archivedAt is null).
// Previous roadmaps are kept with archivedAt set.
// ─────────────────────────────────────────

model Roadmap {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String          // e.g. "Marketing Manager → Product Manager"
  archivedAt  DateTime?       // null = active; set = archived
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  phases      RoadmapPhase[]
}

// ─────────────────────────────────────────
// ROADMAP PHASE
// e.g. "Phase 1: Foundations", "Phase 2: Core Skills"
// ─────────────────────────────────────────

model RoadmapPhase {
  id         String   @id @default(uuid())
  roadmapId  String
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title      String
  order      Int      // 1-based, controls display order
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics     Topic[]
}

// ─────────────────────────────────────────
// TOPIC
// A single learning unit within a phase.
// isCheckpoint = true means the user must pass a quiz to mark it complete.
// ─────────────────────────────────────────

model Topic {
  id              String       @id @default(uuid())
  phaseId         String
  phase           RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title           String
  description     String       // 2–4 sentences, AI-generated
  estimatedHours  Float
  isCheckpoint    Boolean      @default(false)
  order           Int          // 1-based, controls display order within phase
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  resources        Resource[]
  quizAttempts     QuizAttempt[]
  userProgress     UserTopicProgress[]
  explainSessions  ExplainSession[]    // [v1.2]
}

// ─────────────────────────────────────────
// RESOURCE [v1.2 — updated]
// v1.2 changes:
//   - url field added: real URL from web search result (null if unverified)
//   - verificationStatus added: VERIFIED or UNVERIFIED
//   - flaggedForRevalidation added: set true by "Report broken link"; cleared by cron job
//   - searchQuery retained: used as Google fallback when verificationStatus = UNVERIFIED
// For USER-added resources, url is set directly and verificationStatus = VERIFIED by default.
// ─────────────────────────────────────────

enum ResourceType {
  ARTICLE
  COURSE
  DOCUMENTATION
  VIDEO
}

enum ResourceSource {
  AI        // generated during roadmap creation
  USER      // manually added by the user
}

enum VerificationStatus {
  VERIFIED    // search + HEAD check passed; url is a confirmed live link
  UNVERIFIED  // search or HEAD check failed; url is null; searchQuery used as fallback
}

model Resource {
  id                   String             @id @default(uuid())
  topicId              String
  topic                Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title                String
  url                  String?            // [v1.2] real URL from search result; null if UNVERIFIED
  searchQuery          String             // retained as Google fallback for UNVERIFIED resources
  resourceType         ResourceType
  source               ResourceSource     @default(AI)
  verificationStatus   VerificationStatus @default(UNVERIFIED) // [v1.2]
  flaggedForRevalidation Boolean          @default(false)       // [v1.2] set by "Report broken link"
  addedByUserId        String?            // only set when source = USER; loose reference, not a FK
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt            // [v1.2] needed for revalidation tracking

  bookmarks     UserResourceBookmark[]
}

// ─────────────────────────────────────────
// AI CALL LOG [v1.2 — new]
// Append-only observability log for every call made through AIClient.
// Intentionally has NO foreign key relationships — it is infrastructure,
// not an application entity. userId stored as plain string for cost attribution.
// Non-AI jobs (e.g. resource revalidation) also log here with null token counts.
// ─────────────────────────────────────────

enum AIProvider {
  OPENAI
  ANTHROPIC
  NONE      // for non-AI jobs logged here for observability consistency
}

model AICallLog {
  id              String     @id @default(uuid())
  userId          String?    // plain string, not a FK; null for system-level jobs
  featureName     String     // e.g. "generate-roadmap", "generate-quiz", "resource-revalidation"
  provider        AIProvider
  model           String?    // e.g. "gpt-4o", "claude-sonnet-3-5"; null for NONE provider
  promptTokens    Int?       // null for non-AI jobs or failed calls before token info returned
  completionTokens Int?      // null for same reasons
  latencyMs       Int        // wall-clock time of the call in milliseconds
  success         Boolean
  errorMessage    String?    // populated on failure; null on success
  usedFallback    Boolean    @default(false) // [v1.2] true if Anthropic was used as fallback
  createdAt       DateTime   @default(now())
}

// ─────────────────────────────────────────
// EXPLAIN SESSION [v1.2 — new]
// Persists server-side conversation state for the concept explanation panel.
// One session per user per topic, enforced by @@unique.
// turns stores the full conversation as JSON: Array<{ role: "user"|"assistant", content: string }>
// Capped at 10 turns; oldest pruned when cap is reached.
// Deleted by cleanup cron job after 24 hours of inactivity.
// ─────────────────────────────────────────

model ExplainSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  turns         Json     // Array<{ role: "user"|"assistant", content: string }>
  lastActiveAt  DateTime @default(now()) // updated on every new turn; used by cleanup cron
  createdAt     DateTime @default(now())

  ratings       ExplainRating[]

  @@unique([userId, topicId])
}

// ─────────────────────────────────────────
// EXPLAIN RATING [v1.2 — new]
// One row per thumbs-up or thumbs-down on an assistant turn.
// turnIndex is the 0-based index of the assistant turn in ExplainSession.turns.
// Stored separately from ExplainSession for clean aggregation queries.
// ─────────────────────────────────────────

enum ExplainRatingValue {
  THUMBS_UP
  THUMBS_DOWN
}

model ExplainRating {
  id              String             @id @default(uuid())
  sessionId       String
  session         ExplainSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String             // denormalised for query convenience; mirrors session.userId
  turnIndex       Int                // 0-based index of the assistant turn being rated
  rating          ExplainRatingValue
  createdAt       DateTime           @default(now())

  @@unique([sessionId, turnIndex])   // one rating per turn per session
}

// ─────────────────────────────────────────
// USER RESOURCE BOOKMARK
// Join table between User and Resource.
// Replaces the isBookmarked boolean that was previously on Resource.
// This allows each user to maintain their own independent bookmark list,
// and is safe for future multi-user or shared-roadmap scenarios.
// ─────────────────────────────────────────

model UserResourceBookmark {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  bookmarkedAt DateTime @default(now())

  @@unique([userId, resourceId])
}

// ─────────────────────────────────────────
// USER TOPIC PROGRESS
// Join table between User and Topic with status and activity tracking.
// lastActivityAt is updated every time the user changes the status.
// This field is used for streak calculation.
// ─────────────────────────────────────────

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

model UserTopicProgress {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status          TopicStatus @default(NOT_STARTED)
  lastActivityAt  DateTime    @default(now())
  completedAt     DateTime?   // set when status changes to COMPLETE
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, topicId])
}

// ─────────────────────────────────────────
// QUIZ ATTEMPT
// A snapshot of a single quiz session.
// questions stores the full JSON of what was generated and shown.
// answers stores the user's selected option index per question.
// score is the number of correct answers (0–5).
// ─────────────────────────────────────────

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions   Json     // snapshot: Array<{ question, options: string[], correctIndex: number }>
  answers     Json     // user's responses: Array<number> (selected option index per question)
  score       Int      // 0–5
  passed      Boolean  // true if score >= 4
  attemptedAt DateTime @default(now())
}

// ─────────────────────────────────────────
// WEEKLY REVIEW
// AI-generated narrative stored after each Sunday cron run (or manual trigger).
// ─────────────────────────────────────────

model WeeklyReview {
  id                          String   @id @default(uuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate               DateTime // Monday of the reviewed week (for display and deduplication)
  narrative                   String   // AI-generated summary, 200–300 words
  topicsCompleted             Int      // count for the week
  avgQuizScore                Float?   // average quiz score for the week (null if no quizzes taken)
  careerReadinessScoreAtReview Int?    // [v1.2] snapshot of score at time of review generation
  nextTopicTitle              String?  // AI-suggested next topic title
  nextTopicReason             String?  // one-sentence reason from AI
  generatedAt                 DateTime @default(now())
}